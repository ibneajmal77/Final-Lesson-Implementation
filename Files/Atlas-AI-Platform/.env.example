# Example local environment variables.
#
# Python/Pydantic note: `packages.core.config.Settings` reads these because each
# key starts with `ATLAS_`. This is similar to binding `appsettings.json` and
# environment variables into a typed options class in .NET.
ATLAS_ENV=local
ATLAS_APP_NAME=Atlas AI Platform
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000
# FastAPI routes are mounted under this prefix in `apps.api.app.create_app`.
ATLAS_API_PREFIX=/api/v1
# SQLAlchemy database URL. The `postgresql+psycopg` driver name selects psycopg3.
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:55432/atlas?connect_timeout=3
ATLAS_REDIS_URL=redis://localhost:6379/0
ATLAS_LOG_LEVEL=INFO
# Managed provider calls are off by default so tests/local runs use the mock.
ATLAS_MODEL_GATEWAY_ENABLE_MANAGED_PROVIDER=false
ATLAS_OPENAI_COMPATIBLE_API_KEY=
