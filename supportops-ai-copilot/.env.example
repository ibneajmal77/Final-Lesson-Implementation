# ============================================================================
# FILE: .env.example
#
# THINK OF THIS FILE AS: a blank form showing which settings the app expects,
# with example answers filled in — but never the real secrets.
#
# WHAT IT IS: a template. Copy it to a file named `.env` and edit the values for
# your machine. The app reads `.env`; this file is only the pattern for it.
#
#     cp .env.example .env        (then edit .env)
#
# WHY TWO FILES INSTEAD OF ONE: `.env` holds real passwords and API keys, so it
# is listed in .gitignore and never committed. But a newcomer cloning the repo
# still has to know WHICH settings exist, or the app fails with a confusing
# error about a missing value. This file solves that: it is committed, it lists
# every required name, and it contains nothing sensitive.
#
# Keeping configuration in the environment rather than in code is what lets the
# exact same image run on a laptop, in staging and in production with nothing
# changed but these values.
#
# HOW THESE REACH THE CODE: they are not read directly anywhere. Every name here
# maps onto a field of the Settings class in
# apps/api/supportops_api/settings.py, which validates them on startup — so a
# misspelled or missing value is caught immediately at boot rather than hours
# later at the moment it is first needed.
#
#     .env  ->  Settings (apps/api/supportops_api/settings.py)  ->  the whole app
#
# WHO READS IT: docker-compose.yml passes these into both the api and worker
# containers. See infra/staging/env.example for the staging counterpart.
# ============================================================================

# Identifies the service in logs and metrics. Rarely needs changing.
APP_NAME=supportops-ai-copilot

# Which environment this is — local, staging, production. Code and dashboards
# use it to tell environments apart, so staging traffic is never mistaken for
# real customer traffic.
APP_ENV=local

# How much detail to log. INFO is the normal level; DEBUG is far noisier and
# useful when chasing a specific problem.
LOG_LEVEL=INFO

# WHERE THE DATA LIVES. This one string carries the driver, username, password,
# host, port and database name:
#
#     postgresql :// supportops : supportops @ localhost : 5432 / supportops
#     ^database    ^user        ^password    ^host       ^port  ^db name
#
# NOTE `localhost` HERE. That is correct when running the app directly on your
# machine. Inside Docker it must instead be the SERVICE NAME (`postgres`),
# because each container has its own private `localhost` — pointing a container
# at localhost makes it look for a database inside itself, and it will not find
# one. docker-compose.yml overrides this value for exactly that reason, and it
# is the single most common cause of "connection refused" when starting out.
DATABASE_URL=postgresql://supportops:supportops@localhost:5432/supportops

# THE QUEUE between the two programs. When the API accepts an analysis request
# it pushes a job ID here, and the separate worker process picks it up. Only the
# ID travels — never the ticket itself.
#
# The trailing `/0` is a database NUMBER, not a path: Redis provides several
# numbered slots in one server, and this uses the first.
REDIS_URL=redis://localhost:6379/0

# WHICH AI PROVIDER TO USE, and the most important switch in this file.
#
# `mock` selects the fake provider in packages/model_gateway/, which returns a
# canned, correctly-shaped answer without any network call. That is why the test
# suite runs free, offline and identically every time, and why the default here
# is mock rather than a real provider — a fresh clone works immediately, with no
# account and no risk of running up a bill by accident.
MODEL_PROVIDER=mock

# DELIBERATELY EMPTY, and it must stay that way in this file. A real key belongs
# only in your own `.env`, which is never committed.
#
# It can stay empty while MODEL_PROVIDER=mock, since the fake provider never
# authenticates against anything. A real provider requires it.
#
# If you ever paste a genuine key here by mistake, treat it as leaked and rotate
# it — committed secrets remain in the git history even after being deleted.
MODEL_API_KEY=
