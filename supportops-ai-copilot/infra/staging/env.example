# ============================================================================
# FILE: infra/staging/env.example
#
# THINK OF THIS FILE AS: the packing list for a staging deployment, with blank
# labels where the real addresses and secrets must be supplied.
#
# This is a TEMPLATE, not a live configuration file. Copy it to
# `infra/staging/.env.staging`, replace every placeholder, and pass that file to
# Docker Compose with `--env-file`. The copy stays on the staging host; this
# example stays safe to commit because it contains no real credentials.
#
# There are two kinds of setting here. Docker Compose itself uses the image,
# port, and Grafana values. It passes the application values into both the API
# and worker containers, where apps/api/supportops_api/settings.py converts the
# text into validated Python settings.
#
#     infra/staging/.env.staging
#       -> infra/staging/docker-compose.staging.yml
#          -> API + worker -> apps/api/supportops_api/settings.py
#          -> web, Prometheus, and Grafana container configuration
#
# WHO USES IT / WHAT LIVES HERE: docs/stage-17-staging-deployment.md gives the
# deployment commands; infra/staging/docker-compose.staging.yml consumes every
# name below; apps/api/supportops_api/checks.py applies the AI rollout controls.
# ============================================================================

# Copy to infra/staging/.env.staging on the staging host or load these values from a secret manager.
# Do not commit real staging secrets.

# EXACT CONTAINER IMAGES TO DEPLOY. Replace OWNER with the registry owner and
# COMMIT_SHA with the revision built by CI. A revision-specific tag makes a
# deployment repeatable and gives docs/rollback-runbook.md a precise image to
# roll back to.
#
# One API image deliberately serves three roles in docker-compose.staging.yml:
# it runs the database migration, the HTTP API, and the background worker. The
# web image contains the browser console and nginx instead.
SUPPORTOPS_API_IMAGE=ghcr.io/OWNER/supportops-ai-copilot-api:COMMIT_SHA
SUPPORTOPS_WEB_IMAGE=ghcr.io/OWNER/supportops-ai-copilot-web:COMMIT_SHA

# APPLICATION IDENTITY AND LOGGING. These become fields on the Settings class
# in apps/api/supportops_api/settings.py. `staging` labels logs and metrics so
# rehearsal traffic is not confused with local or production traffic; `INFO`
# records normal operational events without the volume of `DEBUG` logging.
APP_NAME=supportops-ai-copilot
APP_ENV=staging
LOG_LEVEL=INFO

# THE TWO EXTERNAL DATA SERVICES. Staging Compose does not start PostgreSQL or
# Redis, so HOST must be the network address of the managed staging service,
# not `localhost` and not a local Compose service name.
#
# DATABASE_URL carries the database driver, user, password, host, port, and
# database name in one value. PostgreSQL stores tickets, analyses, reviews, and
# audit history defined in packages/db/supportops_db/models.py.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/supportops

# Redis is the hand-off point between the API and worker: the API puts an AI-run
# job ID on the queue and apps/worker/supportops_worker/jobs.py loads the real
# data from PostgreSQL. Both programs must use the same Redis address or queued
# jobs will appear to vanish. `/0` selects Redis database number zero.
REDIS_URL=redis://HOST:6379/0

# Browsers normally block a page from calling an API at another origin (an
# origin is the scheme, hostname, and port together). This comma-separated list
# tells apps/api/supportops_api/main.py which web-console origins may call it.
# Use the exact staging HTTPS address; `*` would let any website make requests.
CORS_ORIGINS=https://supportops-staging.example.com

# A THREE-PART SAFETY GATE for AI analysis, enforced by
# apps/api/supportops_api/checks.py. The master switch is on, but the two lists
# narrow the pilot to one company (`tenant_demo`) and billing tickets. Add
# comma-separated values to widen the rollout; set the master switch to false
# for the fastest AI rollback while leaving manual ticket handling available.
AI_ANALYSIS_ENABLED=true
AI_ANALYSIS_ENABLED_TENANTS=tenant_demo
AI_ANALYSIS_ENABLED_CATEGORIES=billing

# WHICH MODEL BACK END TO USE. `mock` is intentionally safe: it returns a fixed,
# local answer without a network call, secret, or bill. To exercise the real
# provider, change this to the provider name supported by
# packages/model_gateway/supportops_model_gateway/routing.py and supply its key
# through the staging host or secret manager.
MODEL_PROVIDER=mock

# Keep this blank in the committed template. It is unused by the mock provider;
# a real key is a password and must never enter Git history. If one is committed
# even briefly, deleting it later is not enough: revoke and replace it.
MODEL_API_KEY=

# MODEL_NAME chooses the particular hosted model, and MODEL_BASE_URL chooses the
# provider endpoint. apps/api/supportops_api/routes/tickets.py uses them for the
# synchronous path; apps/worker/supportops_worker/jobs.py uses the same values
# for queued analysis. The mock provider ignores both and reports its own fixed
# model identity.
MODEL_NAME=gpt-5.6
MODEL_BASE_URL=https://api.openai.com/v1

# Give up after 30 seconds rather than leaving a request or worker stuck
# indefinitely. The output-token cap limits response length and also puts a
# ceiling on one call's output cost. A token is a small piece of text, roughly
# part of a word.
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=1200

# These rates are ACCOUNTING INPUTS for
# packages/model_gateway/supportops_model_gateway/cost.py; they do not change
# what the provider charges. Zero is correct for `mock`, but leaving zero with a
# paid provider makes the dashboards falsely report that AI usage costs nothing.
MODEL_INPUT_COST_PER_1K_TOKENS=0
MODEL_OUTPUT_COST_PER_1K_TOKENS=0

# PORTS EXPOSED ON THE STAGING HOST. The container-side ports stay fixed in
# docker-compose.staging.yml; changing these values only changes where an
# operator or reverse proxy reaches each service on the host. Choose unused
# ports if another stack is already listening on these defaults.
API_HOST_PORT=8765
WEB_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# GRAFANA LOGIN POLICY. These feed only the `grafana` service in
# docker-compose.staging.yml, not the SupportOps Settings class. The username is
# configurable, and the example password MUST be replaced before deployment;
# it is an obvious placeholder rather than a safe staging password.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-before-deploy

# `false` requires a login before anyone can see operational dashboards. Turning
# anonymous access on can expose traffic, failure-rate, and AI-spend information.
GF_AUTH_ANONYMOUS_ENABLED=false
